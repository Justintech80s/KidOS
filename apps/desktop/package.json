{
  "name": "@kidos/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "KidOS for Windows - child-safe Electron experience backed by KidOS Guardian",
  "author": "KidOS",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"pnpm --filter @kidos/shell dev\" \"wait-on http://127.0.0.1:1420 && cross-env KIDOS_DESKTOP_DEV_URL=http://127.0.0.1:1420 electron .\"",
    "build:web": "pnpm --filter @kidos/shell build",
    "build": "pnpm run build:web && electron-builder --win nsis --x64",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.justintech80s.kidos",
    "productName": "KidOS",
    "asar": true,
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../shell/dist",
        "to": "shell"
      },
      {
        "from": "../../target/release/kidos-guardian-host.exe",
        "to": "backend/kidos-guardian-host.exe"
      },
      {
        "from": "../../services/media-classifier/dist/kidos-media-classifier-bundle.zip",
        "to": "backend/kidos-media-classifier-bundle.zip"
      },
      {
        "from": "../../services/media-classifier/dist/model",
        "to": "backend/model"
      },
      {
        "from": "../../scripts/windows",
        "to": "backend/scripts"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KidOS-Windows-x64-${version}-Setup.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KidOS",
      "include": "build/installer.nsh"
    }
  }
}
